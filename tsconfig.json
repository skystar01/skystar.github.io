{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "src/types.d.ts",
    "src/dom-ready.js",
    "src/storage.js",
    "src/mine-solver.js",
    "src/reversi-engine.js",
    "src/flappy-onnx.js",
    "src/ai-trace.js",
    "src/ai-worker.js",
    "src/ai-worker-client.js",
    "tests/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/app.js",
    "src/ai-lab.js",
    "src/ai-bench.js",
    "src/game-feedback.js",
    "src/site-polish.js"
  ]
}
